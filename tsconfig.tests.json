{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".test-build"
  },
  "include": [
    "src/utils/calculations.ts",
    "src/features/meal-planner/algorithm.ts",
    "src/features/backup/validation.ts",
    "src/repositories/local.ts",
    "src/features/profile-photo/persistence.ts"
  ]
}
